step "approve-deployment" {
    name = "Approve deployment"

    action {
        action_type = "Octopus.Manual"
        properties = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = "Reference data for the release page. Leave this deployment paused."
        }
    }
}

step "say-hello" {
    name = "Say hello"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = "echo 'Hello from the full reference project'"
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}

step "use-packages" {
    name = "Use packages"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = "echo 'This step only exists to reference packages'"
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }

        packages "built-in" {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "Reference.Web"
            properties = {
                Extract = "False"
                Purpose = ""
                SelectionMode = "immediate"
            }
        }

        packages "bound" {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "#{BoundPackageId}"
            properties = {
                Extract = "False"
                Purpose = ""
                SelectionMode = "immediate"
            }
        }

        packages "container" {
            acquisition_location = "NotAcquired"
            feed = "docker-hub"
            package_id = "library/nginx"
            properties = {
                Extract = "False"
                Purpose = ""
                SelectionMode = "immediate"
            }
        }

        packages "missing" {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "Reference.Missing"
            properties = {
                Extract = "False"
                Purpose = ""
                SelectionMode = "immediate"
            }
        }
    }
}

step "run-script-from-git" {
    name = "Run script from Git"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptFileName = "scripts/hello.sh"
            Octopus.Action.Script.ScriptSource = "GitRepository"
        }

        git_dependencies {
            default_branch = "main"
            git_credential_type = "Anonymous"
            repository_uri = "https://github.com/TomPeters/octopus-test-cac-project.git"
        }
    }
}
